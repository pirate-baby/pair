{
  "name": "pair",
  "version": "0.1.0",
  "description": "Agent-driven, voice-narrated code walkthroughs in a visual editor, exposed over MCP.",
  "type": "module",
  "bin": {
    "pair": "dist/server/server/src/index.js"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dev:web": "vite",
    "play": "node dist/server/server/src/index.js play",
    "mcp": "node dist/server/server/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jsonc-parser": "^3.3.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "license": "MIT",
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
