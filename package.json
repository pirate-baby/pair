{
  "name": "pair-mcp",
  "version": "0.1.0",
  "description": "Agent-driven, voice-narrated code walkthroughs in a visual editor, exposed over MCP.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "opencode",
    "code-walkthrough",
    "tts"
  ],
  "homepage": "https://github.com/pirate-baby/pair#readme",
  "bugs": {
    "url": "https://github.com/pirate-baby/pair/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pirate-baby/pair.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "pair": "dist/server/server/src/index.js"
  },
  "files": [
    "dist",
    "skills",
    "scripts/config-edit.mjs",
    "install.sh"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dev:web": "vite",
    "play": "node dist/server/server/src/index.js play",
    "mcp": "node dist/server/server/src/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jsonc-parser": "^3.3.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
